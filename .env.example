# 复制成 .env 后改成自己的值：cp .env.example .env

# 初始管理员账号（容器第一次启动时创建）
ADMIN_USER=admin
ADMIN_PASSWORD=请改成你自己的密码

# GitHub 采集用的令牌（可选，不填也能用，但每小时只能查 60 次，填了能查 5000 次）
# 去 https://github.com/settings/tokens 申请一个，不用给任何权限
GITHUB_TOKEN=

# 登录会话加密用的钥匙（随便写一串长的，不要告诉别人）
SESSION_SECRET=请改成一串随机长的字符比如aB3x9Qw2eRt7yU

# ---------- 英文资讯翻译配置（海外AI电商资讯用）----------
# 默认走 MyMemory 免费翻译接口，不用注册就能用。
# MYMEMORY_EMAIL：可选项，填一个你自己的邮箱，免费额度会变大（不填也能翻）
MYMEMORY_EMAIL=

# 下面三项是"高级翻译"配置：如果你想让翻译质量更高，可以接一个 OpenAI 兼容的翻译接口，
# 复用你现有的 DeepSeek 密钥即可。配了之后，英文资讯和 GitHub 项目简介都会走这里翻；
# 不配就走上面的免费接口（GitHub 项目简介不配则不翻译）。
# TRANSLATE_BASE_URL：接口地址，DeepSeek 就填 https://api.deepseek.com/v1
TRANSLATE_BASE_URL=
# TRANSLATE_MODEL：模型名，DeepSeek 就填 deepseek-chat
TRANSLATE_MODEL=
# TRANSLATE_API_KEY：密钥，DeepSeek 的密钥可以直接拿来用
TRANSLATE_API_KEY=
